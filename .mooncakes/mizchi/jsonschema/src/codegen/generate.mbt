///|
pub fn generate(
  raw_json : Json,
  entrypoints : Array[@types.JsonPointer],
  root_name? : String = "Root",
  include_refs? : Bool = true,
  prefix? : String = "",
) -> Result[String, String] raise {
  let logger = StringBuilder::new()
  let entries : Set[@types.JsonPointer] = Set::from_array(entrypoints)
  if include_refs {
    for ref_expr in @validate.collect_refs(raw_json) {
      guard @types.JsonPointer::from_string(ref_expr) is Ok(pointer) else {
        continue
      }
      entries.add(pointer)
    }
  }
  for ref_expr in @validate.collect_refs(raw_json) {
    guard @types.JsonPointer::from_string(ref_expr) is Ok(pointer) else {
      continue
    }
    entries.add(pointer)
  }
  logger.write_string("// Generated by jsonschema\n")
  for entrypoint in entries {
    guard entrypoint.access(raw_json) is Some(json) else { continue }
    let struct_name = match entrypoint {
      @types.JsonPointer::Root => root_name
      @types.JsonPointer::Key(_, key~) => key
      _ => continue
    }
    let resolver = @validate.build_resolver(raw_json)
    try {
      let schema : @types.JsonSchema = @parser.parse_schema(json)
      logger.write_string("\n// \{entrypoint}\n")
      if generate_stmt(
          schema,
          struct_name,
          resolver~,
          pointer=entrypoint,
          prefix~,
        )
        is Ok(code) {
        logger.write_string(code)
      } else {
        logger.write_string("\n// skip by compile error \{entrypoint}\n")
      }
    } catch {
      err => return Err("failed to parse schema at \{entrypoint}: \{err}")
    }
  }
  logger.to_string() |> Ok
}

///|
fn generate_stmt(
  schema : @types.JsonSchema,
  struct_name : String,
  resolver~ : @validate.Resolver,
  prefix? : String = "",
  pointer? : @types.JsonPointer = @types.JsonPointer::Root.key(struct_name),
) -> Result[String, String] {
  match schema {
    @types.JsonSchema::OneOf(s) => {
      guard @types.Enumerable::parse_enumerable(s) is Some(enumerable) else {
        return Err("OneOf without prefixItems is not supported")
      }
      render_enumerable(struct_name, enumerable, prefix~, resolver~, pointer~)
      |> Ok
    }
    @types.JsonSchema::Object(constraints) => {
      // let c : @jsonschema.ObjectConstraints = constraints
      let inner = StringBuilder::new()
      inner.write_string("\{prefix}struct \{struct_name} {\n")
      // constraints
      // if constraints.
      let required_keys = if constraints.required is Some(v) {
        v |> Set::from_array
      } else {
        Set::new()
      }
      let outer = StringBuilder::new()
      for key, subschema in constraints.properties.unwrap() {
        // nested object
        if subschema is @types.JsonSchema::Object(_) {
          let sub_pointer = pointer.key(key)
          let sub_struct_name = "\{struct_name}_\{key}"
          inner.write_string("  \{key}: \{sub_struct_name}\n")
          match
            generate_stmt(
              subschema,
              sub_struct_name,
              resolver~,
              pointer=sub_pointer,
            ) {
            Err(e) => return Err(e)
            Ok(nested_code) => outer.write_string(nested_code)
          }
        } else {
          // child property
          let key_is_required = required_keys.contains(key)
          let subtype_code = generate_type_expr(
            subschema,
            resolver~,
            pointer=pointer.key(key),
          )
          if !key_is_required && !subtype_code.has_suffix("?") {
            inner.write_string("  \{key}: \{subtype_code}?\n")
          } else {
            inner.write_string("  \{key}: \{subtype_code}\n")
          }
        }
      }
      inner
      ..write_string("} derive(Eq, Show, FromJson, ToJson)\n")
      ..write_string(outer.to_string())
      inner.to_string() |> Ok
    }
    @types.JsonSchema::Integer(_)
    | @types.JsonSchema::Number(_)
    | @types.JsonSchema::String(_)
    | @types.JsonSchema::Boolean(_)
    | @types.JsonSchema::Ref(_) => {
      let code = generate_type_expr(schema, resolver~, pointer~)
      "\{prefix}struct \{struct_name}(\{code}) derive(Eq, Show, FromJson, ToJson)"
      |> Ok
    }
    e => "\"Not Supported\" \{e.to_json()}" |> Err
  }
}

///|
fn generate_type_expr(
  schema : @types.JsonSchema,
  resolver~ : @validate.Resolver,
  pointer? : @types.JsonPointer = @types.JsonPointer::Root,
) -> String {
  match schema {
    @types.JsonSchema::Object(_) =>
      return "Error: direct nested schema not supported"
    @types.JsonSchema::Array({ items, .. }) => {
      let logger = StringBuilder::new()
      logger.write_string("Array[")
      if items is Some(value) {
        logger.write_string(
          generate_type_expr(value, resolver~, pointer=pointer.key("index")),
        )
      } else {
        logger.write_string("Any")
      }
      logger.write_string("]")
      return logger.to_string()
    }
    @types.JsonSchema::String(_) => "String"
    @types.JsonSchema::Number(_) => "Double"
    @types.JsonSchema::Integer(_) => "Int"
    @types.JsonSchema::Boolean(_) => "Bool"
    @types.JsonSchema::OneOf(_) =>
      if parse_nullable(schema) is Some(other) {
        generate_type_expr(other, resolver~, pointer~) + "?"
      } else {
        "Json?"
      }
    @types.JsonSchema::Const(_) | @types.JsonSchema::Enum(_) => "Json"
    @types.JsonSchema::Ref({ pointer }) =>
      ref_to_identifier(pointer).unwrap_or("UnresolvedRef")
    _ => "\"unsupported type\""
  }
}

///|
fn parse_nullable(schema : @types.JsonSchema) -> @types.JsonSchema? {
  match schema {
    @types.JsonSchema::OneOf({ schemas, .. }) if schemas.length() == 2 =>
      match schemas {
        [@types.JsonSchema::Null(_), other]
        | [other, @types.JsonSchema::Null(_)] => Some(other)
        _ => None
      }
    _ => None
  }
}

///|
fn ref_to_identifier(pointer : @types.JsonPointer) -> String? {
  match pointer {
    @types.JsonPointer::Root => Some("Root")
    @types.JsonPointer::Key(_, key~) => Some(key)
    @types.JsonPointer::Index(_, index~) => Some(index.to_string())
  }
}

///|
test "mbt code generation" {
  let schema : Json = @json.parse(
    (
      #|{
      #|  "type": "object",
      #|  "properties": {
      #|    "name": { "type": "string" },
      #|    "age": { "type": "number" },
      #|    "items": {
      #|      "type": "array",
      #|      "items": { "type": "string" }
      #|    },
      #|    "opt_str": {
      #|      "oneOf": [
      #|        { "type": "string" },
      #|        { "type": "null" }
      #|      ]
      #|    },
      #|    "opt_number": {
      #|      "oneOf": [
      #|        { "type": "number" },
      #|        { "type": "null" }
      #|      ]
      #|    }
      #|  },
      #|  "required": ["name", "age"]
      #|}
    ),
  )
  let jschema : @types.JsonSchema = @parser.parse_schema(schema)
  let resolver = @validate.build_resolver(schema)
  let code = generate_stmt(jschema, "MyStruct", resolver~)
  inspect(
    code.unwrap(),
    content=(
      #|struct MyStruct {
      #|  name: String
      #|  age: Double
      #|  items: Array[String]?
      #|  opt_str: String?
      #|  opt_number: Double?
      #|} derive(Eq, Show, FromJson, ToJson)
      #|
    ),
  )
}

///|
test "mbt code generation with inner struct" (t : @test.Test) {
  let schema : Json = @json.parse(
    (
      #|{
      #|  "type": "object",
      #|  "properties": {
      #|    "nested": {
      #|      "type": "object",
      #|      "required": ["id"], 
      #|      "properties": {
      #|        "id": { "type": "integer" }
      #|      }
      #|    },
      #|    "d1": {
      #|      "type": "object",
      #|      "required": ["d2"], 
      #|      "properties": {
      #|        "d2": {
      #|          "type": "object",
      #|          "required": ["d3"], 
      #|          "properties": {
      #|            "d3": { "type": "string" }
      #|          }
      #|        }
      #|      }
      #|    }
      #|  },
      #|  "required": ["nested"]
      #|}
    ),
  )
  let jschema : @types.JsonSchema = @parser.parse_schema(schema)
  let resolver = @validate.build_resolver(schema)
  let code = generate_stmt(jschema, "MyStruct", resolver~)
  t..write(code.unwrap())..snapshot(filename="nested_struct.mbt")
}

///|
test "mbt struct generation with ref" {
  let schema : Json = {
    "definitions": {
      "Point": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"],
      },
    },
    "type": "object",
    "properties": {
      "points": { "type": "array", "items": { "$ref": "#/definitions/Point" } },
    },
    "required": ["points"],
  }
  let jschema : @types.JsonSchema = @parser.parse_schema(schema)
  let resolver = @validate.build_resolver({
    "definitions": {
      "Point": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"],
      },
    },
  })
  let code = generate_stmt(jschema, "MyStruct", resolver~)
  inspect(
    code.unwrap(),
    content=(
      #|struct MyStruct {
      #|  points: Array[Point]
      #|} derive(Eq, Show, FromJson, ToJson)
      #|
    ),
  )
}

///|
test "generate_mbt_code" {
  let schema : Json = {
    "definitions": {
      "Point": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"],
      },
      "Point3D": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
        },
        "required": ["x", "y", "z"],
      },
    },
    "type": "object",
    "properties": {
      "points": { "type": "array", "items": { "$ref": "#/definitions/Point" } },
    },
    "required": ["points"],
  }
  let code = generate(
    schema,
    [
      @types.JsonPointer::Root.key("definitions").key("Point3D"),
      @types.JsonPointer::Root,
    ],
    root_name="MyApp",
    include_refs=true,
  )
  inspect(
    code.unwrap(),
    content=(
      #|// Generated by jsonschema
      #|
      #|// #/definitions/Point3D
      #|struct Point3D {
      #|  x: Double
      #|  y: Double
      #|  z: Double
      #|} derive(Eq, Show, FromJson, ToJson)
      #|
      #|// #
      #|struct MyApp {
      #|  points: Array[Point]
      #|} derive(Eq, Show, FromJson, ToJson)
      #|
      #|// #/definitions/Point
      #|struct Point {
      #|  x: Double
      #|  y: Double
      #|} derive(Eq, Show, FromJson, ToJson)
      #|
    ),
  )
}

///|
test "render nested enumberable" (t : @test.Test) {
  let raw : Json = {
    "definitions": {
      "V": {
        "oneOf": [
          {
            "type": "array",
            "prefixItems": [{ "const": "V1" }, { "type": "number" }],
          },
          {
            "type": "array",
            "prefixItems": [{ "const": "V2" }, { "type": "integer" }],
          },
        ],
      },
      "A": {
        "type": "object",
        "required": ["a"],
        "properties": { "a": { "$ref": "#/definitions/V" } },
      },
      "B": {
        "type": "object",
        "required": ["b"],
        "properties": { "b": { "$ref": "#/definitions/A" } },
      },
    },
  }
  let code = generate(
    raw,
    [@types.JsonPointer::Root.key("definitions").key("B")],
    root_name="Root",
  )
  let output = code.unwrap().to_string()
  t.write(output)
  t.snapshot(filename="generated_enum.mbt")
}

///|
test "stmt" (t : @test.Test) {
  let raw : Json = {
    "definitions": {
      "Obj": {
        "type": "object",
        "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
        "required": ["x", "y"],
      },
    },
    "$ref": "#/definitions/Obj",
  }
  let generated = generate(
    raw,
    [
      @types.JsonPointer::Root.key("definitions").key("Obj"),
      @types.JsonPointer::Root,
    ],
    root_name="Root",
  )
  let generated = generated.unwrap_or("failed")
  t.write(generated)
  t.snapshot(filename="generated_ref.mbt")
}

///|
test "generate ref entry" {
  let b = @types.Builder::new()
  let dummy_resolver = @validate.build_resolver({
    "definitions": { "Num": { "type": "integer" } },
  })
  let refstr = @types.JsonPointer::Root.key("definitions").key("Num")
  ref_to_identifier(refstr) |> assert_eq(Some("Num"))
  // let expr = JsonSchema::ref_from_string("#/definitions/Num")
  let expr = b.ref_(@types.JsonPointer::Root.key("definitions").key("Num"))
  generate_type_expr(expr, resolver=dummy_resolver) |> assert_eq("Num")
  generate_type_expr(
    b.array(items=b.ref_from_string("#/definitions/Num")),
    resolver=dummy_resolver,
  )
  |> assert_eq("Array[Num]")
  generate_type_expr(b.string(), resolver=dummy_resolver) |> assert_eq("String")
  generate_type_expr(b.integer(), resolver=dummy_resolver) |> assert_eq("Int")
  generate_type_expr(b.const_("something_json"), resolver=dummy_resolver)
  |> assert_eq("Json")
  generate_type_expr(b.enum_([{ "a": 1 }, { "b": 2 }]), resolver=dummy_resolver)
  |> assert_eq("Json")
}

///|
test "enumerable schema can parse itself" (_t : @test.Test) {
  // TODO: Fix
  let b = @types.Builder::new()
  let s = b.one_of([
    b.array(prefix_items=[b.const_("A"), b.integer(), b.string()]),
    b.array(prefix_items=[b.const_("B"), b.number()]),
    b.array(prefix_items=[b.const_("C"), b.integer()]),
    b.const_("D"),
    b.array(prefix_items=[
      b.const_("Paramed"),
      b.object(properties={ "a": b.integer() }, required=["a"]),
    ]),
  ])
  let str = s.to_json().stringify()
  let reparsed : Json = @json.parse(str)
  let reschema : @types.JsonSchema = @parser.parse_schema(reparsed)
  assert_true(reschema == s)
}
